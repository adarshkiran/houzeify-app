{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "outDir": "./dist-server",
    "rootDir": "./server",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
