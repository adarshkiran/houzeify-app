# ─── Frontend environment (Vite — only VITE_-prefixed vars are exposed to
# the browser) ────────────────────────────────────────────────────────────
# Base URL of the backend API (server/) the frontend's auth layer calls —
# see src/data/apiClient.ts. Defaults to http://localhost:4000 (the
# backend's own default port, see PORT below) when unset, so this line is
# only needed if you run the backend somewhere else.
VITE_API_BASE_URL=http://localhost:4000
# The dev screen switcher and ?screen= deep links are on for `vite dev` only.
# Set to true to also enable them in a built/deployed frontend (demos, QA).
# VITE_ENABLE_DEV_SCREEN_SWITCHER=false

# ─── Backend environment (server/) ──────────────────────────────────────────
# Copy this file to `.env` and fill in the values you need locally.
# Never commit `.env` — it's already git-ignored (see .gitignore).
# See server/README.md for how these are used.

NODE_ENV=development

# Backend API port — independent of the frontend Vite dev server's own PORT
# (vite.config.ts defaults that to 8443, though this repo's dev tooling can
# reassign it dynamically). Kept clear of common frontend ports so running
# both together doesn't collide by default.
PORT=4000
HOST=0.0.0.0

# Postgres connection string (e.g. a Neon connection string). Leave empty
# for local development without a database — the server starts fine without
# it; only GET /api/v1/health/db will report the database as not configured.
DATABASE_URL=

# Comma-separated list of allowed frontend origins (no wildcard support —
# see server/plugins/cors.ts). The Vite dev server in this repo runs on
# http://localhost:8443 by default; adjust if you run it elsewhere.
CORS_ORIGINS=http://localhost:8443

# ─── Auth (server/auth/) ─────────────────────────────────────────────────
# Implementation defaults, not commercial/product entitlements — adjust
# freely. See server/README.md for the full flow.
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
SESSION_EXPIRES_DAYS=30

# MSG91 (India SMS OTP delivery, selected in 12C). Leave all three blank in
# development to use the built-in dev-only console OTP provider (see
# server/auth/providers/devOtpProvider.ts) — it never sends a real SMS and
# logs the OTP with a clearly-marked warning instead. In any other
# NODE_ENV, an unconfigured MSG91 makes OTP requests fail loudly rather
# than fake a successful send.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
